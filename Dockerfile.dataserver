# syntax=docker/dockerfile:1

# ─── Stage 1: build ───────────────────────────────────────────────────────────
FROM golang:1.25-alpine AS builder

WORKDIR /app



# allow Go to auto-download the 1.25.5 toolchain declared in go.mod
ENV GOTOOLCHAIN=auto

# cache deps first (only re-runs when go.mod/go.sum change)
COPY go.mod go.sum ./
RUN go mod download

# copy source
COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /dataserver ./cmd/dataserver

# ─── Stage 2: minimal runtime ─────────────────────────────────────────────────
FROM alpine:3.19

RUN apk add --no-cache ca-certificates tzdata

COPY --from=builder /dataserver /dataserver

EXPOSE 8081

ENTRYPOINT ["/dataserver"]