# syntax=docker/dockerfile:1

# ─── Stage 1: build ───────────────────────────────────────────────────────────
FROM golang:1.25-alpine AS builder

WORKDIR /app



# allow Go to auto-download the 1.25.5 toolchain declared in go.mod
ENV GOTOOLCHAIN=auto
COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /clientserver ./cmd/clientserver

# ─── Stage 2: minimal runtime ─────────────────────────────────────────────────
FROM alpine:3.19

RUN apk add --no-cache ca-certificates tzdata

COPY --from=builder /clientserver /clientserver

EXPOSE 8080

ENTRYPOINT ["/clientserver"]